{
  "name": "consistent-date-picker",
  "version": "1.0.0",
  "description": "An accessible date picker web component that looks and works the same in every browser. Works in plain HTML, Lit, Vue and React.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./define": {
      "types": "./types/define.d.ts",
      "import": "./dist/define.js"
    },
    "./react": {
      "types": "./types/react.d.ts",
      "import": "./dist/react.js"
    },
    "./vue": {
      "types": "./types/vue.d.ts"
    }
  },
  "sideEffects": [
    "./dist/define.js",
    "./dist/react.js"
  ],
  "files": [
    "dist",
    "types",
    "custom-elements.json"
  ],
  "customElements": "custom-elements.json",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ClarkGH/date-picker.git"
  },
  "homepage": "https://github.com/ClarkGH/date-picker#readme",
  "bugs": {
    "url": "https://github.com/ClarkGH/date-picker/issues"
  },
  "keywords": [
    "date-picker",
    "datepicker",
    "web-component",
    "custom-element",
    "lit",
    "accessible",
    "form-associated"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && pnpm analyze",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.spec.json",
    "test:e2e": "playwright test",
    "test:consumers": "node scripts/test-consumers.mjs",
    "analyze": "cem analyze && node scripts/check-manifest.mjs"
  },
  "peerDependencies": {
    "lit": "^3.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "vue": "^3.3.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "dependencies": {
    "@lit/react": "^1.0.8",
    "@popperjs/core": "^2.11.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@playwright/test": "1.65.1",
    "@types/node": "^26.6.7",
    "@types/react": "^19.3.3",
    "jsdom": "^31.0.1",
    "lit": "^3.3.3",
    "react": "^19.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.4.0",
    "vitest": "^5.1.2",
    "vue": "^3.5.46"
  }
}
