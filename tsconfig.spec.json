{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "emitDeclarationOnly": false,
    // Without this, every @types package is loaded. Vitest pulls in @types/node 26, which TS 4.9 cannot parse
    "types": []
  },
  "include": ["src/**/*.ts"],
  "exclude": []
}
